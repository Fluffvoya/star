function(star_find_mimalloc target)
    set(STAR_MIMALLOC_AVAILABLE OFF CACHE INTERNAL "Whether Star found a usable mimalloc target" FORCE)
    find_package(mimalloc CONFIG QUIET)
    if(NOT mimalloc_FOUND)
        return()
    endif()

    if(TARGET mimalloc-static)
        target_link_libraries(${target} PRIVATE mimalloc-static)
    elseif(TARGET mimalloc)
        target_link_libraries(${target} PRIVATE mimalloc)
    elseif(TARGET mimalloc::mimalloc)
        target_link_libraries(${target} PRIVATE mimalloc::mimalloc)
    else()
        message(WARNING "Star: mimalloc was found but no supported CMake target was exported")
        return()
    endif()

    target_compile_definitions(${target} PRIVATE STAR_WITH_MIMALLOC=1)
    set(STAR_MIMALLOC_AVAILABLE ON CACHE INTERNAL "Whether Star found a usable mimalloc target" FORCE)
endfunction()
